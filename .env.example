# ---------------------------------------------------------------------------
# Google Ads Intelligence Layer - environment configuration
# Copy to .env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Application ---
APP_ENV=development                 # development | staging | production
APP_DEBUG=true
APP_LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
APP_LOG_JSON=false                  # true -> JSON logs (use in production)
API_PREFIX=/api/v1

# --- Database (PostgreSQL) ---
# Either provide DATABASE_URL directly, or the discrete POSTGRES_* parts below.
DATABASE_URL=postgresql+psycopg://ads:ads@localhost:5432/ads_intelligence
POSTGRES_USER=ads
POSTGRES_PASSWORD=ads
POSTGRES_DB=ads_intelligence
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# --- Google Ads API ---
# https://developers.google.com/google-ads/api/docs/first-call/overview
GOOGLE_ADS_DEVELOPER_TOKEN=your-developer-token
GOOGLE_ADS_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_ADS_REFRESH_TOKEN=your-oauth-refresh-token
# Manager (MCC) account id, digits only, no dashes.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=1234567890
# Optional: API version pinned by the client library. Leave blank for library default.
GOOGLE_ADS_API_VERSION=
# Optional path to a google-ads.yaml file. If set, it overrides the discrete vars above.
GOOGLE_ADS_YAML_PATH=

# --- Sync engine / scheduler ---
SCHEDULER_ENABLED=true
SYNC_HOURLY_ENABLED=true
SYNC_DAILY_ENABLED=true
SYNC_DAILY_HOUR=4                   # local hour (0-23) for the daily deep sync
SYNC_MAX_RETRIES=3
SYNC_RETRY_BACKOFF_SECONDS=30
SYNC_DEFAULT_LOOKBACK_DAYS=7        # window for metric-bearing reports
# Comma-separated client customer ids to sync. Empty -> discover all under the MCC.
GOOGLE_ADS_CLIENT_CUSTOMER_IDS=

# --- Security (placeholder for Phase 2 auth) ---
# Optional shared key to guard mutating endpoints. Leave blank to disable the gate.
# NOTE: keep this on its own line — an inline comment would be read as the value.
API_KEY=

# --- AI Ad Copy Generator (Phase 3) ---
# Optional Anthropic key for the hybrid LLM backend. Leave blank to use the
# deterministic (data-driven) generator — the module works either way.
ANTHROPIC_API_KEY=
AD_COPY_LLM_MODEL=claude-sonnet-5
AD_COPY_LLM_ENABLED=true
AD_COPY_LLM_MAX_TOKENS=2000
KEYWORD_PLANNER_ENABLED=true        # falls back to historical if token lacks access
LANDING_PAGE_TIMEOUT_SECONDS=12

# --- Gemini (optional LLM backend for testing) ---
# Provider selection: auto = Anthropic if its key is set, else Gemini, else deterministic.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AD_COPY_LLM_PROVIDER=auto            # auto | anthropic | gemini
